# Vigil Backend — Environment Configuration
# Copy to .env and fill in your values.
# Never commit .env — only commit this .env.example.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL async DSN
DATABASE_URL=postgresql+asyncpg://vigil:changeme@localhost:5432/vigil

# ─── MQTT Broker ─────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
# Leave blank if no auth required
MQTT_USERNAME=
MQTT_PASSWORD=
# Topic pattern for sensor readings
MQTT_TOPIC=vigil/machines/+/readings

# ─── API ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Energy cost ─────────────────────────────────────────────────────────────
# Default electricity tariff INR/kWh (overridden per-machine in DB)
DEFAULT_TARIFF_INR_PER_KWH=8.50

# ─── Anomaly detection ───────────────────────────────────────────────────────
# Minimum readings required before anomaly detection activates
ANOMALY_MIN_BASELINE_SAMPLES=60
# Z-score threshold to trigger warning
ANOMALY_WARNING_Z=2.5
# Z-score threshold to trigger critical
ANOMALY_CRITICAL_Z=4.0
# Rolling window size for baseline computation
ANOMALY_BASELINE_WINDOW=300

# ─── Simulator (dev/demo only — never shown in UI) ───────────────────────────
SIMULATOR_MACHINE_ID=machine-001
SIMULATOR_INTERVAL_S=3
